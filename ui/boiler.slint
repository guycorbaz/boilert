// Boiler illustration (the hand-drawn assets/boiler.svg silhouette, with
// its pipes), tinted with the measured stratification gradient: c0 is the
// color at the TOP of the tank (hottest water) down to c5 at the BOTTOM
// (coldest water). The six colors are interpolated by the Rust backend from
// the configured sensors, so the drawing reflects the real profile.
export component Boiler {
    in property <color> c0: #6e6e6e;
    in property <color> c1: #6e6e6e;
    in property <color> c2: #6e6e6e;
    in property <color> c3: #6e6e6e;
    in property <color> c4: #6e6e6e;
    in property <color> c5: #6e6e6e;

    Image {
        source: @image-url("assets/boiler.svg");
        width: 100%;
        height: 100%;
        colorize: @linear-gradient(180deg,
            root.c0 0%,
            root.c1 20%,
            root.c2 40%,
            root.c3 60%,
            root.c4 80%,
            root.c5 100%);
    }
}
