import { Theme, NavButton } from "styles.slint";
import { Sensor, SensorData } from "sensor.slint";

// One row of the two-column sensor grid: shows sensors `first` and
// `first + 1` (the second one only if it exists).
component SensorRow inherits HorizontalLayout {
    in property <[SensorData]> sensors;
    in property <int> first;

    spacing: 12px;

    Sensor {
        data: root.sensors[root.first];
    }

    if root.sensors.length > root.first + 1: Sensor {
        data: root.sensors[root.first + 1];
    }
}

export component StatsPage {
    // Back button
    callback back();

    in property <[SensorData]> sensors;

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.bg;

        // Page title
        Text {
            x: Theme.pad + 4px;
            y: 14px;
            text: "Températures";
            color: Theme.text-primary;
            font-size: 24pt;
            font-weight: 800;
        }

        // Two-column grid for up to 6 sensor cards. It stops above the
        // navigation button so nothing ever overlaps it.
        VerticalLayout {
            x: Theme.pad;
            y: 62px;
            width: parent.width - 2 * Theme.pad;
            height: 334px;
            spacing: 10px;

            if root.sensors.length > 0: SensorRow {
                sensors: root.sensors;
                first: 0;
            }
            if root.sensors.length > 2: SensorRow {
                sensors: root.sensors;
                first: 2;
            }
            if root.sensors.length > 4: SensorRow {
                sensors: root.sensors;
                first: 4;
            }
        }

        // Navigation button (same spot on every page)
        NavButton {
            x: parent.width - self.width - Theme.pad;
            y: parent.height - self.height - Theme.pad;
            text: "Retour";
            clicked => {
                root.back();
            }
        }
    }
}
