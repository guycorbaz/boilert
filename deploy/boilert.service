# systemd *user* unit for running boilert on a Raspberry Pi with a desktop
# session. A user unit (unlike a system unit) inherits the session environment
# (DISPLAY / WAYLAND_DISPLAY / XAUTHORITY / XDG_RUNTIME_DIR), so it works on
# both the X11 and the Wayland (Bookworm and later) variants of Raspberry Pi
# OS without hardcoding display variables.
#
# Install (as the desktop user, NOT with sudo):
#   mkdir -p ~/.config/systemd/user
#   cp deploy/boilert.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now boilert
#
# The unit starts with the graphical session; with the usual kiosk setup
# (desktop autologin, the Raspberry Pi Imager default) that means at boot.
#
# Logs: journalctl --user -u boilert -f

[Unit]
Description=boilert - water boiler heat monitor
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Directory containing config.toml and the persisted history file (%h = home)
WorkingDirectory=%h/boilert
ExecStart=%h/boilert/boilert %h/boilert/config.toml
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=info

[Install]
WantedBy=graphical-session.target
