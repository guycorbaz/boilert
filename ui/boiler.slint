// Component representing the boiler (hot water tank)
export component Boiler {
    // Color at the top of the tank (hottest water)
    in property <color> top-color: red;
    // Color at the bottom of the tank (coldest water)
    in property <color> bottom-color: blue;

    Rectangle {
        width: 100%;
        height: 100%;
        Image {
            source: @image-url("assets/boiler.svg");
            width: parent.width;
            height: parent.height;
            // Tint the silhouette with the measured stratification gradient
            colorize: @linear-gradient(180deg, root.top-color 0%, root.bottom-color 100%);
        }
    }
}
