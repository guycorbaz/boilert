import { PageStyle } from "styles.slint";
import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Sensor, SensorData } from "sensor.slint";

// One row of the two-column sensor grid: shows sensors `first` and
// `first + 1` (the second one only if it exists).
component SensorRow inherits HorizontalBox {
    in property <[SensorData]> sensors;
    in property <int> first;

    spacing: 20px;

    Sensor {
        data: root.sensors[root.first];
    }

    if root.sensors.length > root.first + 1: Sensor {
        data: root.sensors[root.first + 1];
    }
}

export component StatsPage {
    // Back button
    callback back();

    in property <[SensorData]> sensors;

    Rectangle {
        background: black;
        border-color: black;
        border-width: 1px;
        x: 1px * PageStyle.ext_padding;
        y: 1px * PageStyle.ext_padding;
        width: parent.width - 1px * PageStyle.ext_padding;
        height: parent.height - 0px * PageStyle.ext_padding;

        // Page title
        Text {
            y: 0;
            text: "Statistiques de température";
            color: white;
            font-size: 20pt;
            font-weight: 800;
        }

        Rectangle {
            y: 60px;
            background: black;

            // Two-column layout for up to 6 sensors (Slint's GridLayout
            // doesn't support dynamic 'for' loops, so rows are explicit).
            VerticalBox {
                spacing: 20px;
                padding: 0px;
                if root.sensors.length > 0: SensorRow {
                    sensors: root.sensors;
                    first: 0;
                }
                if root.sensors.length > 2: SensorRow {
                    sensors: root.sensors;
                    first: 2;
                }
                if root.sensors.length > 4: SensorRow {
                    sensors: root.sensors;
                    first: 4;
                }
            }
        }

        // Back button
        Button {
            text: "Retour";
            width: 120px;
            height: 40px;
            x: parent.width - self.width - 20px;
            y: parent.height - self.height - 20px;
            clicked => {
                root.back();
            }
        }
    }
}
