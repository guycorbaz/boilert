import { PageStyle } from "styles.slint";
import { Button } from "std-widgets.slint";
import { Boiler } from "boiler.slint";

// Main dashboard page showing boiler status summary
export component DashboardPage {
    // Callback to switch to the statistics page
    callback show-stats();
    // Pre-formatted energy currently stored in the boiler (kWh)
    in property <string> energy-text: "-.-";
    // True while the MQTT broker connection is up
    in property <bool> mqtt-connected: false;
    // False when at least one sensor failed its last reading
    in property <bool> sensors-ok: true;
    // Stratification colors computed from the measured temperatures
    in property <color> boiler-top-color: #6e6e6e;
    in property <color> boiler-bottom-color: #6e6e6e;

    Rectangle {
        width: parent.width - 2px * PageStyle.ext_padding;
        height: parent.height - 2px * PageStyle.ext_padding;
        background: black;
        border-color: black;
        border-width: 1px;
        x: 1px * PageStyle.ext_padding;
        y: 1px * PageStyle.ext_padding;

        // Page title
        Text {
            y: 0;
            text: "Eau chaude";
            color: white;
            font-size: 20pt;
            font-weight: 800;
        }

        // MQTT connection indicator (top right)
        Rectangle {
            x: parent.width - 92px;
            y: 12px;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: root.mqtt-connected ? #2ecc71 : #e74c3c;
        }
        Text {
            x: parent.width - 72px;
            y: 9px;
            text: "MQTT";
            color: white;
            font-size: 10pt;
        }

        // Sensor failure warning
        if (!root.sensors-ok): Text {
            x: parent.width - 140px;
            y: 36px;
            text: "⚠ défaut sonde";
            color: #f39c12;
            font-size: 10pt;
        }

        // Visual representation of the boiler, tinted with the measured
        // stratification (hot at the top, cold at the bottom)
        Boiler {
            x: 50px;
            y: 90px;
            width: 240px;
            height: 280px;
            top-color: root.boiler-top-color;
            bottom-color: root.boiler-bottom-color;
        }

        // Energy stored value
        Text {
            x: 400px;
            y: 180px;
            text: root.energy-text + " kWh";
            color: red;
            font-size: 45pt;
            font-weight: 800;
        }

        // Navigation button
        Button {
            text: "Stat";
            width: 120px;
            height: 40px;
            x: parent.width - self.width - 20px;
            y: parent.height - self.height - 20px;
            clicked => {
                root.show-stats();
            }
        }
    }
}
