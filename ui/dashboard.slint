import { Theme, NavButton } from "styles.slint";
import { Boiler } from "boiler.slint";

// Main dashboard page showing boiler status summary
export component DashboardPage {
    // Callback to switch to the statistics page
    callback show-stats();
    // Pre-formatted energy currently stored in the boiler (kWh)
    in property <string> energy-text: "-.-";
    // 24 h history graph of the stored energy
    in property <string> energy-hist-path: "";
    in property <string> energy-hist-fill: "";
    in property <string> energy-hist-min-text: "";
    in property <string> energy-hist-max-text: "";
    // True while the MQTT broker connection is up
    in property <bool> mqtt-connected: false;
    // False when at least one sensor failed its last reading
    in property <bool> sensors-ok: true;
    // Current temperature at the top / bottom of the tank (pre-formatted)
    in property <string> top-temp-text: "--";
    in property <string> bottom-temp-text: "--";
    // Stratification colors, top (c0) to bottom (c5)
    in property <color> c0: #6e6e6e;
    in property <color> c1: #6e6e6e;
    in property <color> c2: #6e6e6e;
    in property <color> c3: #6e6e6e;
    in property <color> c4: #6e6e6e;
    in property <color> c5: #6e6e6e;

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.bg;

        // Page title
        Text {
            x: Theme.pad + 4px;
            y: 14px;
            text: "Eau chaude";
            color: Theme.text-primary;
            font-size: 24pt;
            font-weight: 800;
        }

        // MQTT connection chip (top right)
        Rectangle {
            x: parent.width - self.width - Theme.pad;
            y: 18px;
            width: 108px;
            height: 34px;
            border-radius: 17px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.card-border;

            Rectangle {
                x: 14px;
                y: parent.height / 2 - 5px;
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: root.mqtt-connected ? Theme.good : Theme.critical;
            }
            Text {
                x: 34px;
                height: 100%;
                vertical-alignment: center;
                text: "MQTT";
                color: Theme.text-secondary;
                font-size: 11pt;
            }
        }

        // Sensor failure chip, next to the MQTT chip
        if (!root.sensors-ok): Rectangle {
            x: parent.width - self.width - Theme.pad - 118px;
            y: 18px;
            width: 158px;
            height: 34px;
            border-radius: 17px;
            background: #fab21922;
            border-width: 1px;
            border-color: Theme.warning;

            Text {
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: "⚠ défaut sonde";
                color: Theme.warning;
                font-size: 11pt;
            }
        }

        // Water tank drawing tinted with the measured stratification
        // (200x300 matches the SVG's aspect ratio)
        Boiler {
            x: 64px;
            y: 92px;
            width: 200px;
            height: 300px;
            c0: root.c0;
            c1: root.c1;
            c2: root.c2;
            c3: root.c3;
            c4: root.c4;
            c5: root.c5;
        }

        // Top / bottom tank temperatures next to the tank
        Text {
            x: 286px;
            y: 106px;
            text: "Haut  " + root.top-temp-text;
            color: Theme.text-secondary;
            font-size: 13pt;
        }
        Text {
            x: 286px;
            y: 360px;
            text: "Bas  " + root.bottom-temp-text;
            color: Theme.text-secondary;
            font-size: 13pt;
        }

        // Stored energy card: hero number + 24 h history graph
        Rectangle {
            x: 412px;
            y: 92px;
            width: parent.width - 412px - Theme.pad;
            height: 300px;
            border-radius: Theme.radius;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.card-border;

            Text {
                x: 26px;
                y: 16px;
                text: "Énergie stockée";
                color: Theme.text-secondary;
                font-size: 13pt;
            }
            HorizontalLayout {
                x: 26px;
                y: 40px;
                height: 96px;
                spacing: 14px;
                alignment: start;

                Text {
                    text: root.energy-text;
                    color: Theme.text-primary;
                    font-size: 46pt;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                Text {
                    text: "kWh";
                    color: Theme.text-muted;
                    font-size: 18pt;
                    vertical-alignment: center;
                }
            }

            // Evolution of the stored energy over the last 24 hours
            energy-graph := Rectangle {
                x: 26px;
                y: 156px;
                width: 320px;
                height: 100px;

                // Recessive gridlines (top, middle, baseline)
                Rectangle { y: 0; width: 100%; height: 1px; background: #ffffff12; }
                Rectangle { y: parent.height / 2; width: 100%; height: 1px; background: #ffffff12; }
                Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: #ffffff1e; }

                // The 320x100 viewbox matches this area's aspect ratio
                // (Slint scales a Path preserving the aspect ratio).
                Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: 320;
                    viewbox-height: 100;
                    fill: @linear-gradient(180deg, #3987e54d 0%, #3987e500 100%);
                    commands: root.energy-hist-fill;
                }
                Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: 320;
                    viewbox-height: 100;
                    stroke: Theme.series;
                    stroke-width: 2px;
                    commands: root.energy-hist-path;
                }

                // Auto-scale bounds (kWh)
                Text {
                    x: 4px;
                    y: 1px;
                    text: root.energy-hist-max-text;
                    color: Theme.text-muted;
                    font-size: 9pt;
                }
                Text {
                    x: 4px;
                    y: parent.height - self.height - 2px;
                    text: root.energy-hist-min-text;
                    color: Theme.text-muted;
                    font-size: 9pt;
                }
            }

            // Graph caption
            Text {
                x: 26px;
                y: 262px;
                text: "24 dernières heures";
                color: Theme.text-muted;
                font-size: 9pt;
            }
        }

        // Navigation button (same spot on every page)
        NavButton {
            x: parent.width - self.width - Theme.pad;
            y: parent.height - self.height - Theme.pad;
            text: "Statistiques";
            clicked => {
                root.show-stats();
            }
        }
    }
}
