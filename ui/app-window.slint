import { DashboardPage, StatsPage, SensorData } from "pages.slint";
import { Theme } from "styles.slint";

// Main application window that coordinates pages and data
export component AppWindow inherits Window {
    width: 800px;
    height: 480px;
    background: Theme.bg;
    title: "boilert";
    // Borderless: no title bar, so the full 800x480 panel is usable
    no-frame: true;

    // Flag to control which page to display (0: Dashboard, 1: Statistics)
    property <int> active-page: 0;

    // Pre-formatted total thermal energy stored (kWh), from the Rust backend
    in property <string> energy-text: "-.-";

    // 24 h history graph of the stored energy (SVG paths + scale labels)
    in property <string> energy-hist-path: "";
    in property <string> energy-hist-fill: "";
    in property <string> energy-hist-min-text: "";
    in property <string> energy-hist-max-text: "";

    // SemVer compatible application version string
    in property <string> app-version: "0.0.0";

    // True while the MQTT broker connection is up
    in property <bool> mqtt-connected: false;

    // False when at least one sensor failed its last reading
    in property <bool> sensors-ok: true;

    // Stratification colors interpolated by the backend from the measured
    // temperatures: c0 = top of the tank (hottest), c5 = bottom (coldest)
    in property <color> boiler-c0: #6e6e6e;
    in property <color> boiler-c1: #6e6e6e;
    in property <color> boiler-c2: #6e6e6e;
    in property <color> boiler-c3: #6e6e6e;
    in property <color> boiler-c4: #6e6e6e;
    in property <color> boiler-c5: #6e6e6e;

    // Dynamic model containing data for all configured temperature sensors.
    // This model is populated and updated by the Rust backend loop.
    in property <[SensorData]> sensors;

    // Page: Dashboard
    if (active-page == 0): DashboardPage {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        energy-text: root.energy-text;
        energy-hist-path: root.energy-hist-path;
        energy-hist-fill: root.energy-hist-fill;
        energy-hist-min-text: root.energy-hist-min-text;
        energy-hist-max-text: root.energy-hist-max-text;
        mqtt-connected: root.mqtt-connected;
        sensors-ok: root.sensors-ok;
        top-temp-text: root.sensors.length > 0 ? root.sensors[0].value-text : "--";
        bottom-temp-text: root.sensors.length > 0 ? root.sensors[root.sensors.length - 1].value-text : "--";
        c0: root.boiler-c0;
        c1: root.boiler-c1;
        c2: root.boiler-c2;
        c3: root.boiler-c3;
        c4: root.boiler-c4;
        c5: root.boiler-c5;
        show-stats => {
            active-page = 1;
        }
    }

    // Page: Stats
    if (active-page == 1): StatsPage {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        sensors: root.sensors;

        back => {
            active-page = 0;
        }
    }

    // Version display at the bottom left
    Text {
        text: "v" + root.app-version;
        color: Theme.text-muted;
        font-size: 10px;
        x: 10px;
        y: parent.height - self.height - 5px;
    }
}
